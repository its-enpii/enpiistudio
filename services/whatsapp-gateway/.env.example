APP_NAME="Enpii WhatsApp Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=enpii_gateway
DB_USERNAME=enpii
DB_PASSWORD=enpii-local

CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

EVOLUTION_API_DRIVER=http
EVOLUTION_API_URL=https://evolution.example.internal
EVOLUTION_API_KEY=
EVOLUTION_API_TIMEOUT=10
GATEWAY_RATE_LIMIT=60
