{
  "name": "@its-enpii/skeleton",
  "version": "0.1.0",
  "description": "Layout presets and brand.css template for Enpii Studio applications",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-enpii/enpiistudio.git",
    "directory": "packages/skeleton"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "brand.css",
    "dist"
  ],
  "main": "./dist/enpii-skeleton.umd.cjs",
  "module": "./dist/enpii-skeleton.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enpii-skeleton.js",
      "require": "./dist/enpii-skeleton.umd.cjs"
    },
    "./styles.css": "./dist/enpii-skeleton.css",
    "./brand.css": "./brand.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "dev": "vite"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@its-enpii/ui": "^0.8.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@its-enpii/ui": "^0.8.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
