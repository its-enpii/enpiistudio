{
  "name": "@its-enpii/ui",
  "version": "0.10.0",
  "description": "Internal presentational Vue components for Enpii Studio products",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-enpii/enpiistudio.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "src",
    "tailwind.preset.js",
    "tailwind.v4.css"
  ],
  "main": "./dist/enpii-ui.umd.cjs",
  "module": "./dist/enpii-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enpii-ui.js",
      "require": "./dist/enpii-ui.umd.cjs"
    },
    "./styles.css": "./dist/enpii-ui.css",
    "./tokens.css": "./dist/enpii-ui.css",
    "./config": "./src/config.ts",
    "./config/node": "./src/config-node.ts",
    "./vite": {
      "types": "./dist/vite-plugin/enpii-ui.d.ts",
      "import": "./dist/vite-plugin/enpii-ui.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./theme/sky/tokens.css": "./src/theme/sky/tokens.css",
    "./tailwind.preset": {
      "import": "./dist/tailwind.preset.js",
      "require": "./dist/tailwind.preset.js"
    },
    "./tailwind.v4.css": "./dist/tailwind.v4.css",
    "./styles/material": "./dist/styles/material.css",
    "./styles/glassmorphism": "./dist/styles/glassmorphism.css",
    "./styles/neumorphism": "./dist/styles/neumorphism.css",
    "./styles/neobrutalism": "./dist/styles/neobrutalism.css",
    "./styles/minimalism": "./dist/styles/minimalism.css",
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "build:tailwind": "vite --config vite.config.tailwind.ts build",
    "check": "vue-tsc --noEmit",
    "test": "vitest run --exclude tests/config-loader.test.ts --exclude tests/tailwind-theme.test.ts",
    "test:tailwind": "npm run build:tailwind && vitest run tests/tailwind-theme.test.ts tests/config-loader.test.ts --config vitest.config.tailwind.ts && node scripts/tailwind-smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
