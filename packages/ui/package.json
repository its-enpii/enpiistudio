{
  "name": "@its-enpii/ui",
  "version": "0.8.2",
  "description": "Internal presentational Vue components for Enpii Studio products",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-enpii/enpiistudio.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "main": "./dist/enpii-ui.umd.cjs",
  "module": "./dist/enpii-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enpii-ui.js",
      "require": "./dist/enpii-ui.umd.cjs"
    },
    "./styles.css": "./dist/enpii-ui.css",
    "./tokens.css": "./dist/enpii-ui.css",
    "./styles/material": "./dist/styles/material.css",
    "./styles/glassmorphism": "./dist/styles/glassmorphism.css",
    "./styles/neumorphism": "./dist/styles/neumorphism.css",
    "./styles/neobrutalism": "./dist/styles/neobrutalism.css",
    "./styles/minimalism": "./dist/styles/minimalism.css",
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "@types/qrcode": "^1.5.6"
  }
}
