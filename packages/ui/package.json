{
  "name": "@enpii-studio/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Internal presentational Vue components for Enpii Studio products",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/enpii-ui.umd.cjs",
  "module": "./dist/enpii-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enpii-ui.js",
      "require": "./dist/enpii-ui.umd.cjs"
    },
    "./styles.css": "./dist/enpii-ui.css",
    "./tokens.css": "./dist/enpii-ui.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
