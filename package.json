{
  "name": "enpii-studio-packages",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/bridge",
    "packages/ui"
  ],
  "scripts": {
    "docs:dev": "npm run dev --prefix docs-site",
    "docs:build": "npm run build --prefix docs-site",
    "docs:preview": "npm run preview --prefix docs-site",
    "ui:build": "npm run build --workspace @its-enpii/ui",
    "ui:check": "npm run check --workspace @its-enpii/ui",
    "ui:test": "npm run test --workspace @its-enpii/ui",
    "ui:pack": "npm pack --workspace @its-enpii/ui --dry-run",
    "contract:check": "redocly lint contracts/whatsapp-gateway/openapi.yaml contracts/core/media.yaml contracts/core/notification.yaml",
    "contract:check:core": "redocly lint contracts/core/media.yaml contracts/core/notification.yaml",
    "bridge:generate": "openapi-typescript contracts/core/media.yaml -c /dev/null -o packages/bridge/src/generated/media.d.ts && openapi-typescript contracts/core/notification.yaml -c /dev/null -o packages/bridge/src/generated/notification.d.ts && openapi-typescript contracts/whatsapp-gateway/openapi.yaml -c /dev/null -o packages/bridge/src/generated/whatsapp-gateway.d.ts"
  },
  "devDependencies": {
    "@redocly/cli": "^2.39.0",
    "debug": "^4.4.3",
    "https-proxy-agent": "^9.1.0",
    "yaml": "^2.8.3"
  }
}
