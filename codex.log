import re

with open('src/styles/tokens.css') as f:
    content = f.read()

# Parse :root tokens
root_tokens = set()
root_match = re.match(r':root\\s*\\{(["'^}]+)'"\\}', content, re.DOTALL)
if root_match:
    root_tokens = set(re.findall(r'--(enpii-[a-zA-Z0-9-]+)', root_match.group(1)))

# Parse prefers-color-scheme dark tokens
dark_mq = re.search(r'@media\\s*\\(prefers-color-scheme:\\s*dark\\)\\s*\\{["'^}]*:root:not'"\\(\\[data-theme=.light.\\]\\)\\s*\\{(["'^}]+)'"\\}', content, re.DOTALL)
dark_mq_tokens = set()
if dark_mq:
    dark_mq_tokens = set(re.findall(r'--(enpii-[a-zA-Z0-9-]+)', dark_mq.group(1)))

# All default-defined tokens = root + dark fallback
all_defaults = root_tokens | dark_mq_tokens
print(f'Root: {len(root_tokens)}, dark-MQ: {len(dark_mq_tokens)}, combined defaults: {len(all_defaults)}')

# Parse each theme
themes = re.findall(r\\\"\\[data-theme='(["'^'"']+)'\\]\\s*\\{(["'^}]+)'"\\}\\\", content, re.DOTALL)
for theme_name, block in themes:
    theme_tokens = set(re.findall(r'--(enpii-[a-zA-Z0-9-]+)', block))
    missing = all_defaults - theme_tokens
    extra = theme_tokens - all_defaults
    print(f'{theme_name}: {len(theme_tokens)} tokens, missing {len(missing)}, extra {len(extra)}')
    if missing:
        for m in sorted(missing)[:10]:
            print(f'  MISSING: --{m}')
        if len(missing)>10:
            print(f'  ... and {len(missing)-10} more')
