import re

with open('src/styles/tokens.css') as f:
    content = f.read()

# Parse each theme and find missing non-inherited tokens
# Tokens that are theme-specific (color/surface/shadow) need per-theme values
# Tokens that are structural (radius, timing, breakpoint, font) can inherit from :root

root_tokens = set(re.findall(r'--(enpii-[a-zA-Z0-9-]+)', re.match(r':root\\s*\\{(["'^}]+)'"\\}', content, re.DOTALL).group(1)))

# Structural tokens that can safely inherit
structural = {t for t in root_tokens if not any(x in t for x in ['color-', 'shadow-', 'surface', 'outline', 'on-'])}

themes = re.findall(r\\\"\\[data-theme='(["'^'"']+)'\\]\\s*\\{(["'^}]+)'"\\}\\\", content, re.DOTALL)
for theme_name, block in themes:
    theme_tokens = set(re.findall(r'--(enpii-[a-zA-Z0-9-]+)', block))
    missing_nonstructural = {t for t in root_tokens - theme_tokens if t in structural}
    # Actually inverse: structural tokens NOT overridden are fine
    # We need to find color tokens NOT overridden
    missing_color = {t for t in root_tokens - theme_tokens if 'color-' in t or 'shadow' in t}
    if missing_color:
        print(f'{theme_name}: missing {len(missing_color)} color/shadow tokens:')
        for m in sorted(missing_color):
            print(f'  --{m}')
    else:
        print(f'{theme_name}: all color/shadow tokens defined')
