    # Badge: white on error -> use on-error
    (\"background:var(--enpii-color-error);color:#fff\", \"background:var(--enpii-color-error);color:var(--enpii-color-on-error)\"),
    # Tooltip: white on on-surface inverse
    (\"background:var(--enpii-color-on-surface);color:#fff\", \"background:var(--enpii-color-on-surface);color:var(--enpii-color-surface-inverse)\"),
    # Theme menu swatches -> tokens
    (\"background:#4f46e5\", \"background:var(--enpii-color-primary)\"),
    (\"background:#f7f9fb\", \"background:var(--enpii-color-surface)\"),
    (\"background:#191c1e\", \"background:var(--enpii-color-on-surface)\"),
    # Typing dot
    (\"background:#94a3b8\", \"background:var(--enpii-color-outline)\"),
    # Notification dropdown badge
    (\"background:var(--enpii-color-error);color:#fff;font-size:.625rem;font-weight:600;box-shadow:0 0 0 2px var(--enpii-color-surface)\",
     \"background:var(--enpii-color-error);color:var(--enpii-color-on-error);font-size:.625rem;font-weight:600;box-shadow:0 0 0 2px var(--enpii-color-surface)\"),
    # Assistant widget thumbnail remove overlay
    (\"background:rgb(0 0 0/60%);color:#fff\", \"background:rgb(0 0 0/60%);color:var(--enpii-color-surface-inverse)\"),
    # Icon container hardcoded text colors -> use appropriate on-color tokens
    (\"background:var(--enpii-color-secondary-container);color:#004d34\", \"background:var(--enpii-color-secondary-container);color:var(--enpii-color-on-secondary)\"),
    (\"background:var(--enpii-color-tertiary-fixed);color:#4a2800\", \"background:var(--enpii-color-tertiary-fixed);color:var(--enpii-color-on-tertiary)\"),
    # Offline banner
    (\"background:color-mix(in srgb,var(--enpii-color-secondary-container) 95%,transparent);color:#004d34\", \"background:color-mix(in srgb,var(--enpii-color-secondary-container) 95%,transparent);color:var(--enpii-color-on-secondary)\"),
    # Footer dark
    (\"background:var(--enpii-color-primary-deep);color:#fff\", \"background:var(--enpii-color-primary-deep);color:var(--enpii-color-on-primary)\"),
    # Stepper completed marker
    (\"background:var(--enpii-color-success-text);color:#fff\", \"background:var(--enpii-color-success-text);color:var(--enpii-color-on-primary)\"),
]

count = 0
for old, new in fixes:
    if old in content:
        content = content.replace(old, new, 1)
        count += 1

with open('src/styles/components.css', 'w') as f:
    f.write(content)
print(f\"Applied {count}/{len(fixes)} color fixes\")
