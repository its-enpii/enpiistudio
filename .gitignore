# Local Claude state
/.claude/

# Local environment
/.env
/.env.*
!/.env.example

# Legacy reference, not part of the active baseline
/enpii-studio-packages/

# PHP dependencies and test artifacts
/vendor/
/services/*/vendor/
/.phpunit.cache/
/.phpunit.result.cache
/services/*/.phpunit.cache/
/services/*/.phpunit.result.cache
/coverage/
composer.phar

# Gateway runtime state
/services/*/.env
/services/*/storage/framework/cache/*
/services/*/storage/framework/sessions/*
/services/*/storage/framework/views/*
/services/*/storage/logs/*
/services/*/bootstrap/cache/*.php
!/services/*/storage/framework/cache/.gitignore
!/services/*/storage/framework/sessions/.gitignore
!/services/*/storage/framework/views/.gitignore
!/services/*/storage/logs/.gitignore
!/services/*/bootstrap/cache/.gitignore

# Node dependencies and generated UI output
/node_modules/
/packages/*/node_modules/
/packages/*/dist/
/packages/*/coverage/
/packages/*/.vite/
/packages/*/.vitest/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and OS files
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
